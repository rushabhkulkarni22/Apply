# Copy to backend/deployment.env. Never commit the copy.
# Use an alphanumeric password here to avoid URL-encoding issues in DATABASE_URL.
POSTGRES_PASSWORD=replaceWithALongRandomAlphanumericPassword
ENVIRONMENT=production
DEMO_ENABLED=false
APP_ORIGIN=https://your-domain.example
RESUME_STORAGE=filesystem
PUBLIC_HOSTNAME=your-domain.example
TLS_EMAIL=you@example.com
GOOGLE_CLIENT_ID=
SALES_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# These endpoints must belong to a supported, permitted integration.
PROVIDER_URL=
PROVIDER_TOKEN=
JOB_FEED_URL=
